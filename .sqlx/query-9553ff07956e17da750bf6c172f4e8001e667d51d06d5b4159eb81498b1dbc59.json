  "query": "select s.id, s.user_id, s.stage, s.csrf_token, s.last_verified_at as \"last_verified_at: DateTime<Utc>\"\n           from sessions s join users u on u.id = s.user_id\n          where s.token_hash = $1 and s.expires_at > now() and u.disabled_at is null",
