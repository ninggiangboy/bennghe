  "query": "select t.id, t.user_id, t.role, t.project_ids, t.last_used_at as \"last_used_at: DateTime<Utc>\"\n           from api_tokens t join users u on u.id = t.user_id\n          where t.token_hash = $1 and t.revoked_at is null and t.expires_at > now() and u.disabled_at is null",
